# ============================================================
# 脱敏模板：复制为 deploy/web.env 后填写，权限设为 600
#   cp deploy/web.env.example deploy/web.env
#   chmod 600 deploy/web.env
#   vi deploy/web.env      # 替换所有 CHANGE_ME 与 <项目根>
# 本文件不是可用配置，所有 CHANGE_ME 必须替换为真实值。
# deploy/web.env 已被 .gitignore 排除，禁止提交到 GitHub。
# ============================================================

POLICY_MATCH_MODE=full_model
POLICY_CORE_ENABLED=0
POLICY_SHOWCASE_ENABLED=0
MODEL_SETTINGS_PATH='<项目根>/config/model_settings.yaml'

# ==== 向量后端（2560 维 Qwen3 嵌入 + Qwen3 重排）====
EMBED_PLATFORM=local-qwen3-emb
POLICY_VECTOR_TABLE=policy_vector_qwen3
EMBED_TOKENIZER_PATH='<项目根>/models/qwen3-embedding-4b'
EMBED_TOKENIZER_MODEL=qwen3-embedding-4b
LOCAL_EMBED_GGUF=/path/to/Qwen3-Embedding-4B-Q4_K_M.gguf
LOCAL_RERANK_GGUF=/path/to/Qwen3-Reranker-4B.Q4_K_M.gguf

# 本地 LLM（llama-server + GGUF）。deploy/start.sh 用这两个变量拉起 8081 端口的模型服务；
# 不设置时 start.sh 使用脚本内的默认路径，换机器部署时请显式填写。
# LOCAL_LLM_SERVER=/path/to/llama.cpp/build/bin/llama-server
# LOCAL_LLM_MODEL=/path/to/Qwen3.6-35B-A3B-UD-Q4_K_M_MTP.gguf

# 负责嵌入/重排进程的 Python（GPU 环境）
LOCAL_MODEL_PYTHON=/path/to/miniconda3/envs/smart-help-gpu/bin/python

# ==== 数据路径（必须指向本机项目内的真实位置）====
POLICY_SOURCE_ROOT='<项目根>/data'
POLICY_EVIDENCE_BUNDLE='<项目根>/src/data/policy_evidence/bundle.json'
CHAIN_TRACE_DIR='<项目根>/runtime/logs'

PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
CUDA_VISIBLE_DEVICES=0
PYTHONPATH='<项目根>/deploy'

# ==== 认证与数据库（CHANGE_ME 必须替换；密码含 @ / # % 时按 URL 编码）====
SMART_HELP_AUTH_JWT_SECRET=CHANGE_ME_COPY_SOURCE_SECRET_NOT_NEW_RANDOM_ON_EVERY_BOOT
ADMIN_SECRET=CHANGE_ME_COPY_SOURCE_SECRET
ADMIN_DB_URL=postgresql+psycopg2://smart_help_policy:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:54321/policy_db_mig20261021
SMART_HELP_AUTH_DATABASE_URL=postgresql+psycopg2://smart_help_auth_app:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:54321/smart_help_auth_mig20261021

# ==== 预算与超时（生产实测值，可按机器性能调整）====
FULL_MODEL_MAX_SOURCES_PER_TURN=10
FULL_MODEL_MAX_CALLS=60
FULL_MODEL_DEADLINE=300
FULL_MODEL_CALL_TIMEOUT=150

# ==== 规则引擎 / 知识图谱开关 ====
FORBID_STRATEGY=v2
KG_GRAPH_ENABLED=1
RULE_ENGINE=on
RULE_SHADOW=1
RULE_WORKER_INTERVAL=60

# ==== 功能开关（0 = 回退旧行为）====
SSE_EVENTS_V2=1
EVENT_REPLAY=1
REGION_SOFT_FILTER=1
CONFLICT_SCOPE_PROGRAM=1
EVIDENCE_CACHE=1
INTAKE_ENGINE=1
AGENT_LOOP=1
AGENT_MAX_STEPS=3
AGENT_MAX_CALLS=3
AGENT_DEADLINE=30
ANSWER_CLAIMS=1
MODEL_REGISTRY=1

# ==== 监听地址（0.0.0.0 = 对局域网开放 Web:5000；改为 127.0.0.1 仅本机）====
WEB_BIND_HOST=0.0.0.0
