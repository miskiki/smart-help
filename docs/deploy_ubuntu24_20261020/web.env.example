# 模板：复制为 /home/adminroot/smart-help/deploy/web.env 后填写。
# 此文件不是当前业务配置；所有CHANGE_ME必须替换，权限设为600。
# systemd不会展开$HOME，路径必须实际写全。
POLICY_MATCH_MODE=full_model
POLICY_CORE_ENABLED=0
POLICY_SHOWCASE_ENABLED=0
ADMIN_DB_URL=postgresql+psycopg2://smart_help_policy:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:54321/policy_db_mig20261020
SMART_HELP_AUTH_DATABASE_URL=postgresql+psycopg2://smart_help_auth:CHANGE_ME_URL_ENCODED_PASSWORD@127.0.0.1:54321/smart_help_auth_mig20261020
SMART_HELP_AUTH_JWT_SECRET=CHANGE_ME_COPY_SOURCE_SECRET_NOT_NEW_RANDOM_ON_EVERY_BOOT
ADMIN_SECRET=CHANGE_ME_COPY_SOURCE_SECRET
MODEL_SETTINGS_PATH=/home/adminroot/smart-help/chatchat_data/model_settings.yaml
# 仅源索引实际属于同一bge模型和权重时使用此平台。
EMBED_PLATFORM=local-offline
LOCAL_MODEL_PYTHON=/home/adminroot/miniforge3/envs/smart-help-gpu/bin/python
LOCAL_EMBED_PATH=/home/adminroot/smart-help/models/bge-base-zh-v1.5
LOCAL_RERANK_PATH=/home/adminroot/smart-help/models/bge-reranker-base
EMBED_TOKENIZER_PATH=/home/adminroot/smart-help/models/bge-base-zh-v1.5
EMBED_TOKENIZER_MODEL=bge-base-zh-v1.5
POLICY_SOURCE_ROOT=/home/adminroot/smart-help/data
POLICY_EVIDENCE_BUNDLE=/home/adminroot/smart-help/Langchain-Chatchat-master/admin_panel/data/policy_evidence/bundle.json
CHAIN_TRACE_DIR=/home/adminroot/smart-help/runtime/logs
TRACE_LOG_LEVEL=summary
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1
